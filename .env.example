# Copy this file to .env.local for local development.
# Copy it to .env for docker compose.

NEXT_PUBLIC_APP_NAME=UpgradePilot

# UpgradePilot -> TrueForge.
# Local dev default:
TRUEFORGE_BASE_URL=http://localhost:8790
# Docker compose overrides this to http://trueforge:8790 inside the network.

# Docker compose pulls this image for the patched TrueForge server.
# Build and push it from the local patched TrueForge clone before sharing real execution.
TRUEFORGE_IMAGE=jvxdock/trueforget-sandbox-repo:upgradepilot-mvp

# Optional server-side token for higher GitHub API limits.
# GITHUB_TOKEN=

# Required for real TrueForge -> Daytona sandbox execution.
# The configure script writes this into TrueForge through /api/v1/settings/sandbox-providers.
# DAYTONA_API_KEY=
# DAYTONA_API_URL=
# DAYTONA_TARGET=
DAYTONA_EXEC_TIMEOUT_MS=600000
DAYTONA_AUTO_STOP_MINUTES=5
DAYTONA_AUTO_ARCHIVE_MINUTES=60
DAYTONA_AUTO_DELETE_MINUTES=7200
# DAYTONA_RESOURCE_CPU=
# DAYTONA_RESOURCE_MEMORY=
# DAYTONA_RESOURCE_DISK=

# Optional repair-agent model provider.
# Baseline and passing verify-upgrade runs do not use this.
# GEMINI_API_KEY=
TRUEFORGE_GEMINI_MODEL_ID=gemini-2.5-flash
TRUEFORGE_GEMINI_MODEL_NAME=gemini-2.5-flash
TRUEFORGE_MODEL_NAME=google-gemini/gemini-2.5-flash
TRUEFORGE_REPAIR_REASONING_EFFORT=low
TRUEFORGE_REPAIR_MAX_TOKENS=2400
TRUEFORGE_REPAIR_ITERATION_LIMIT=5
TRUEFORGE_REPAIR_MIN_INTERVAL_MS=15000
TRUEFORGE_REPAIR_BACKOFF_MS=15000
